[Desktop Entry]
Type=Application
Icon=harbour-deadascend
# Note that these are useless in sandboxed apps:
X-Nemo-Application-Type=qtquick2
X-Nemo-Single-Instance=yes
Exec=invoker -t qtquick2 /usr/bin/DeadAscend
Name=Dead Ascend

[X-Sailjail]
# these are used in main.cpp per default:
#ApplicationName=Dead Ascend
#OrganizationName=Black Grain

# spaces not allowed:
ApplicationName=DeadAscend
# "Application development organization as a reverse domain name"
OrganizationName=dk.blackgrain
Permissions=Audio

#[X-HarbourBackup]
#BackupConfigList=/dk/blackgrain/DeadAscend
#BackupPathList=.local/share/dk.blackgrain/DeadAscend/
